# Ejemplo de configuración de firma del release (sin valores reales).
#
# Copiá este archivo como `keystore.properties` en la raíz del proyecto y completalo. Ese archivo y el
# .jks NO se versionan ni se entregan (están en .gitignore): quien tenga la clave puede publicar
# actualizaciones haciéndose pasar por la app.
#
# Si `keystore.properties` falta o está incompleto, el build no falla: genera el release SIN firmar.

# Ruta al keystore, FUERA del proyecto (barras normales también en Windows).
storeFile=C:/Users/TU_USUARIO/.android/recordatorios-release.jks
storePassword=CAMBIAR
keyAlias=recordatorios
keyPassword=CAMBIAR
