<?xml version="1.0" encoding="utf-8"?>
<!--
    Copia de seguridad y transferencia entre dispositivos (Android 12+). Mismo criterio que
    backup_rules.xml: solo viajan las preferencias de DataStore. Ni la base Room (los datos se recuperan
    desde Firestore al ingresar) ni la sesión de Firebase Authentication salen del dispositivo.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
