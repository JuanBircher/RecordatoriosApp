# Reglas de R8 para la versión release.
# AGP combina todos los archivos de src/main/keepRules y se los pasa a R8.
#
# Gson lee y escribe los DTO por reflexión: si R8 renombrara o quitara sus campos, el servicio y la app
# dejarían de entenderse. Se conservan los campos de los modelos que viajan por la red (y del estado del
# servicio simulado, que también se serializa con Gson).
-keepclassmembers class com.juanbircher.recordatorios.data.remote.** {
    <fields>;
}
-keep class com.juanbircher.recordatorios.data.remote.RecordatorioDto { <init>(...); }
