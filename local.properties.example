# Ejemplo de configuración local (no contiene secretos).
#
# Copiá estas líneas en `local.properties` (en la raíz del proyecto, junto a `gradlew`). Ese archivo NO se
# versiona; Android Studio ya lo crea con `sdk.dir`. Si no agregás nada, la app compila igual con los
# valores predeterminados de abajo.

# Host del Firebase Local Emulator Suite que usa el flavor `dev`.
# - Emulador de Android: 10.0.2.2 (es la PC vista desde el emulador). Es el valor predeterminado.
# - Teléfono físico: la IP de la PC en la red local (por ejemplo 192.168.0.10). En ese caso también hay que
#   agregar esa IP en app/src/dev/res/xml/network_security_config.xml y arrancar los emuladores con
#   "host": "0.0.0.0" en firebase/firebase.json.
firebase.emulador.host=10.0.2.2
