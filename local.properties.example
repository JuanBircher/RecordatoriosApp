# Ejemplo de configuración del servicio remoto.
#
# Copiá este archivo como `local.properties` (en la raíz del proyecto, junto a `gradlew`) y ajustá los
# valores. `local.properties` NO se versiona: no hay URL ni credenciales reales en el repositorio.
# Android Studio ya crea ese archivo con `sdk.dir`; solo agregá estas líneas.
#
# Si no agregás nada, la app compila igual con los valores predeterminados de abajo.

# URL base del servicio REST (con https). Con el servicio simulado no se usa para conectarse, pero es la
# URL que Retrofit arma en cada petición.
recordatorios.baseUrl=https://api.recordatorios.example/

# true  -> el servicio lo simula la propia app (sin red): ideal para probar y entregar.
# false -> Retrofit y OkHttp salen a la red real contra recordatorios.baseUrl.
recordatorios.simulado=true
